# DISCORD_BOT_TOKEN: Discord Bot Token (Bot <token>) for joining Discord servers, reading channel messages, and sending bot embeds via Discord REST API v10.
# Configure this securely in the Secrets panel in AI Studio.
DISCORD_BOT_TOKEN=YOUR_DISCORD_BOT_TOKEN

# DISCORD_WEBHOOK_URL: Discord Channel Webhook URL for acting as TCG roleplay characters with custom character username and avatar overrides.
# Configure this securely in the Secrets panel in AI Studio.
DISCORD_WEBHOOK_URL=YOUR_DISCORD_WEBHOOK_URL
